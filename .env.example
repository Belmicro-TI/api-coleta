NODE_ENV=development

# Sankhya - Login interno (SOAP/MGE)
SANKHYA_LOGIN_USER=
SANKHYA_LOGIN_PASSWORD=

# Sankhya - API Gateway (autenticação OAuth)
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=

# Keycloak - Client Credentials
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_TOKEN_URL=https://idp.grupobelmicro.com.br/realms/usuarios-internos/protocol/openid-connect/token

# CORS - origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=*

# Print Bridge - serviço local de impressão
PRINT_BRIDGE_URL=
PRINT_BRIDGE_TOKEN=
